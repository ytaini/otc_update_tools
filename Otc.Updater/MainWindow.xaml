<Window x:Class="Otc.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="http://schemas.otc.com/localization"
        Title="{loc:Loc Key=Updater.WindowTitle}"
        Width="780"
        Height="620"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        Icon="Assets/updater-icon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="132" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#0F172A" />
                    <GradientStop Offset="0.62" Color="#1E3A8A" />
                    <GradientStop Offset="1" Color="#2563EB" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="54"
                       Height="54"
                       VerticalAlignment="Center"
                       Source="Assets/updater-icon.png"
                       Stretch="Uniform" />

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{loc:Loc Key=Updater.HeaderTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="#C9D8F7"
                               Text="{loc:Loc Key=Updater.HeaderSubtitle}" />
                </StackPanel>

                <ComboBox x:Name="LanguageBox"
                          Grid.Column="2"
                          Width="118"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center"
                          SelectionChanged="OnLanguageChanged"
                          Style="{StaticResource HeaderComboBoxStyle}"
                          ToolTip="{loc:Loc Key=Common.Language.ToolTip}" />

                <Border Grid.Column="3"
                        Padding="9,4"
                        VerticalAlignment="Top"
                        Background="#22FFFFFF"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="#6EE7A8" />
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{loc:Loc Key=Updater.Badge.Process}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="EmptyState"
              Grid.Row="1"
              Margin="28,24,28,0"
              Visibility="Collapsed">
            <Border MaxWidth="560" VerticalAlignment="Center" Style="{StaticResource CardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="66"
                            Height="66"
                            Background="{StaticResource WarningSoftBrush}"
                            CornerRadius="{StaticResource CircleCornerRadius}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="29"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="!" />
                    </Border>
                    <TextBlock Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="{loc:Loc Key=Updater.Empty.Title}" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="{loc:Loc Key=Updater.Empty.Desc}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="UpdateContent" Grid.Row="1" Margin="28,24,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ProductText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{loc:Loc Key=Updater.Field.Product}" />
                        <TextBlock x:Name="VersionText"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="1.0.0 → 1.0.1" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="{loc:Loc Key=Updater.Badge.Approved}" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Border x:Name="Stage1Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage1Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="1" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{loc:Loc Key=Updater.Stage.WaitExit}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Border x:Name="Stage2Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage2Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="2" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{loc:Loc Key=Updater.Stage.Validate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <Border x:Name="Stage3Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage3Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="3" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{loc:Loc Key=Updater.Stage.Backup}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <Border x:Name="Stage4Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage4Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="4" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{loc:Loc Key=Updater.Stage.Replace}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <Border x:Name="Stage5Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage5Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="5" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="{loc:Loc Key=Updater.Stage.Health}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="StatusText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="{loc:Loc Key=Updater.Status.Preparing}" />
                            <TextBlock x:Name="StatusDetailText"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{loc:Loc Key=Updater.Status.PreparingDetail}" />
                        </StackPanel>
                        <TextBlock x:Name="ProgressPercentText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="0%" />
                    </Grid>
                    <ProgressBar x:Name="ProgressBar"
                                 Height="8"
                                 Margin="0,16,0,0"
                                 Maximum="100"
                                 Minimum="0"
                                 Value="0" />
                </StackPanel>
            </Border>

            <Expander x:Name="LogExpander"
                      Grid.Row="3"
                      Margin="0,14,0,0"
                      Header="{loc:Loc Key=Updater.Expander.Log}"
                      IsExpanded="False">
                <Border Margin="0,8,0,0"
                        Padding="14"
                        Background="#111827"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBox x:Name="LogText"
                             MinHeight="120"
                             MaxHeight="180"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             Foreground="#DCE7F8"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Border>
            </Expander>
        </Grid>

        <Grid Grid.Row="2" Margin="28,18,28,24">
            <TextBlock x:Name="FooterHintText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{loc:Loc Key=Updater.Footer.Hint}" />
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    Click="OnCloseClick"
                    Content="{loc:Loc Key=Updater.Action.Close}"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
