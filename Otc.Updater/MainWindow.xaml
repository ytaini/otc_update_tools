<Window x:Class="Otc.Updater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OTC 通用更新器"
        Width="780"
        Height="620"
        MinWidth="700"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        Icon="Assets/updater-icon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="132" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#0F172A" />
                    <GradientStop Offset="0.62" Color="#1E3A8A" />
                    <GradientStop Offset="1" Color="#2563EB" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="54"
                       Height="54"
                       VerticalAlignment="Center"
                       Source="Assets/updater-icon.png"
                       Stretch="Uniform" />

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="通用软件更新器" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="#C9D8F7"
                               Text="安全校验 · 本地暂存 · 自动备份 · 健康检查 · 失败回滚" />
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="9,4"
                        VerticalAlignment="Top"
                        Background="#22FFFFFF"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="#6EE7A8" />
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="独立更新进程" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid x:Name="EmptyState"
              Grid.Row="1"
              Margin="28,24,28,0"
              Visibility="Collapsed">
            <Border MaxWidth="560" VerticalAlignment="Center" Style="{StaticResource CardStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <Border Width="66"
                            Height="66"
                            Background="{StaticResource WarningSoftBrush}"
                            CornerRadius="{StaticResource CircleCornerRadius}">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="29"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="!" />
                    </Border>
                    <TextBlock Margin="0,18,0,0"
                               HorizontalAlignment="Center"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="请由主程序启动更新" />
                    <TextBlock Margin="0,8,0,0"
                               HorizontalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="更新器需要产品、版本、安装目录和签名校验参数。"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="UpdateContent" Grid.Row="1" Margin="28,24,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ProductText"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="产品" />
                        <TextBlock x:Name="VersionText"
                                   Margin="0,5,0,0"
                                   FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="1.0.0 → 1.0.1" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            Background="{StaticResource AccentSoftBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <TextBlock FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="签名包已批准" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <Border x:Name="Stage1Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage1Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="1" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="等待退出" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <Border x:Name="Stage2Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage2Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="2" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="校验更新包" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <Border x:Name="Stage3Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage3Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="3" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="备份旧版本" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <Border x:Name="Stage4Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage4Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="4" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="替换并启动" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                        <Border x:Name="Stage5Circle" Width="28" Height="28" Background="#EDF1F7" CornerRadius="{StaticResource CircleCornerRadius}">
                            <TextBlock x:Name="Stage5Number" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Text="5" />
                        </Border>
                        <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="健康检查" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="StatusText"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="准备更新" />
                            <TextBlock x:Name="StatusDetailText"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="正在准备更新环境..." />
                        </StackPanel>
                        <TextBlock x:Name="ProgressPercentText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="0%" />
                    </Grid>
                    <ProgressBar x:Name="ProgressBar"
                                 Height="8"
                                 Margin="0,16,0,0"
                                 Maximum="100"
                                 Minimum="0"
                                 Value="0" />
                </StackPanel>
            </Border>

            <Expander x:Name="LogExpander"
                      Grid.Row="3"
                      Margin="0,14,0,0"
                      Header="查看详细日志"
                      IsExpanded="False">
                <Border Margin="0,8,0,0"
                        Padding="14"
                        Background="#111827"
                        CornerRadius="{StaticResource ControlCornerRadius}">
                    <TextBox x:Name="LogText"
                             MinHeight="120"
                             MaxHeight="180"
                             Background="Transparent"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             Foreground="#DCE7F8"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Border>
            </Expander>
        </Grid>

        <Grid Grid.Row="2" Margin="28,18,28,24">
            <TextBlock x:Name="FooterHintText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="更新过程中请勿关闭计算机或断开电源。" />
            <Button x:Name="CloseButton"
                    HorizontalAlignment="Right"
                    Click="OnCloseClick"
                    Content="关闭"
                    IsEnabled="False"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>
    </Grid>
</Window>
