<Window x:Class="Otc.Publisher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="http://schemas.otc.com/localization"
        Title="{loc:Loc Key=Publisher.WindowTitle}"
        Width="1020"
        Height="900"
        MinWidth="900"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI Variable, Microsoft YaHei UI"
        Icon="Assets/publisher-icon.png">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="132" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0" Color="#08233C" />
                    <GradientStop Offset="0.58" Color="#0F5F68" />
                    <GradientStop Offset="1" Color="#0D9488" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Width="58"
                       Height="58"
                       VerticalAlignment="Center"
                       Source="Assets/publisher-icon.png"
                       Stretch="Uniform" />

                <StackPanel Grid.Column="1" Margin="16,0,20,0" VerticalAlignment="Center">
                    <TextBlock FontSize="23"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{loc:Loc Key=Publisher.HeaderTitle}" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="#CDEDEA"
                               Text="{loc:Loc Key=Publisher.HeaderSubtitle}" />
                </StackPanel>

                <ComboBox x:Name="LanguageBox"
                          Grid.Column="2"
                          Width="118"
                          Margin="0,0,16,0"
                          VerticalAlignment="Center"
                          SelectionChanged="OnLanguageChanged"
                          Style="{StaticResource HeaderComboBoxStyle}"
                          ToolTip="{loc:Loc Key=Common.Language.ToolTip}" />

                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Border Padding="9,5"
                            Background="#20FFFFFF"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{loc:Loc Key=Publisher.Badge.Signature}" />
                    </Border>
                    <Border Margin="8,0,0,0"
                            Padding="9,5"
                            Background="#20FFFFFF"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{loc:Loc Key=Publisher.Badge.Transport}" />
                    </Border>
                    <Border Margin="8,0,0,0"
                            Padding="9,5"
                            Background="#20FFFFFF"
                            BorderBrush="#38FFFFFF"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Text="{loc:Loc Key=Publisher.Badge.Database}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer x:Name="FormScrollViewer"
                      Grid.Row="1"
                      Margin="24,20,24,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="{StaticResource CircleCornerRadius}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="1" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{loc:Loc Key=Publisher.Section.Basic.Title}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{loc:Loc Key=Publisher.Section.Basic.Desc}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.ProductCode}" />
                                <ComboBox x:Name="ProductCodeBox"
                                          IsEditable="True"
                                          Style="{StaticResource InputComboBoxStyle}">
                                    <ComboBoxItem Content="CC_WPF" />
                                    <ComboBoxItem Content="WMS_WPF" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.ProductType}" />
                                <ComboBox x:Name="ProductTypeBox"
                                          IsEditable="True"
                                          Style="{StaticResource InputComboBoxStyle}">
                                    <ComboBoxItem Content="WCS" />
                                    <ComboBoxItem Content="WMS" />
                                    <ComboBoxItem Content="WCM" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.Version}" />
                                <TextBox x:Name="VersionBox"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.TargetType}" />
                                <ComboBox x:Name="TargetTypeBox"
                                          SelectedIndex="0"
                                          SelectionChanged="OnTargetTypeChanged"
                                          Style="{StaticResource InputComboBoxStyle}">
                                    <ComboBoxItem Content="all" />
                                    <ComboBoxItem Content="device" />
                                    <ComboBoxItem Content="workshop" />
                                    <ComboBoxItem Content="rollout" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.Remark}" />
                                <TextBox x:Name="RemarkBox"
                                         Height="64"
                                         Padding="11,8"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="{StaticResource CircleCornerRadius}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="2" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{loc:Loc Key=Publisher.Section.Files.Title}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{loc:Loc Key=Publisher.Section.Files.Desc}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.SourceDirectory}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SourceDirectoryBox"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Click="OnBrowseSource"
                                            Content="{loc:Loc Key=Publisher.Action.Browse}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.UpdaterDirectory}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UpdaterDirectoryBox"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Click="OnBrowseUpdater"
                                            Content="{loc:Loc Key=Publisher.Action.Browse}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="4">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.ShareDirectory}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ShareDirectoryBox"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Click="OnBrowseShare"
                                            Content="{loc:Loc Key=Publisher.Action.Browse}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="6">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.PrivateKey}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PrivateKeyBox"
                                             Style="{StaticResource InputTextBoxStyle}" />
                                    <Button Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Click="OnBrowsePrivateKey"
                                            Content="{loc:Loc Key=Publisher.Action.Browse}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="{StaticResource CircleCornerRadius}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="3" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{loc:Loc Key=Publisher.Section.Database.Title}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{loc:Loc Key=Publisher.Section.Database.Desc}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.DatabaseHost}" />
                                <TextBox x:Name="HostBox" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.DatabasePort}" />
                                <TextBox x:Name="PortBox" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.DatabaseName}" />
                                <TextBox x:Name="DatabaseBox" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.DatabaseUser}" />
                                <TextBox x:Name="UsernameBox" Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.DatabasePassword}" />
                                <PasswordBox x:Name="PasswordBox"
                                             Style="{StaticResource InputPasswordBoxStyle}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="28"
                                    Height="28"
                                    Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="{StaticResource CircleCornerRadius}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           Text="4" />
                            </Border>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Text="{loc:Loc Key=Publisher.Section.Policy.Title}" />
                                <TextBlock Margin="0,3,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{loc:Loc Key=Publisher.Section.Policy.Desc}" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="18" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.TargetValue}" />
                                <TextBox x:Name="TargetValueBox"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabelStyle}"
                                           Text="{loc:Loc Key=Publisher.Field.RolloutPercent}" />
                                <TextBox x:Name="RolloutPercentBox"
                                         Style="{StaticResource InputTextBoxStyle}" />
                            </StackPanel>

                            <CheckBox x:Name="MandatoryBox"
                                      Grid.Row="2"
                                      Grid.Column="0"
                                      Grid.ColumnSpan="3"
                                      VerticalAlignment="Center"
                                      Content="{loc:Loc Key=Publisher.Checkbox.Mandatory}"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Expander x:Name="LogExpander"
                          Margin="0,14,0,20"
                          Padding="0"
                          Header="{loc:Loc Key=Publisher.Expander.Log}"
                          IsExpanded="False">
                    <Border Margin="0,8,0,0"
                            Padding="16"
                            Background="#111827"
                            CornerRadius="{StaticResource ControlCornerRadius}">
                        <TextBox x:Name="LogText"
                                 Height="150"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 FontFamily="Cascadia Mono, Consolas"
                                 FontSize="11"
                                 Foreground="#DCE7F8"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" />
                    </Border>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               Text="{loc:Loc Key=Publisher.Status.Preparing}" />
                    <ProgressBar x:Name="ProgressBar"
                                 Width="360"
                                 Height="6"
                                 Margin="0,9,0,0"
                                 HorizontalAlignment="Left"
                                 Maximum="100"
                                 Minimum="0"
                                 Value="0" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button x:Name="GenerateKeyButton"
                            Margin="0,0,10,0"
                            Click="OnGenerateKeys"
                            Content="{loc:Loc Key=Publisher.Action.GenerateKeys}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button x:Name="PublishButton"
                            Click="OnPublish"
                            Content="{loc:Loc Key=Publisher.Action.Publish}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
