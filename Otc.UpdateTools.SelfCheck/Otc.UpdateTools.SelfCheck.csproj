    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Otc.UpdateTools.SelfCheck</AssemblyName>
    <RootNamespace>Otc.UpdateTools.SelfCheck</RootNamespace>
